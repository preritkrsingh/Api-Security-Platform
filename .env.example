# ==============================================================================
# AI-Based API Security Threat Detection and Risk Assessment Platform
# Environment Configuration Template (Placeholders Only - No Real Secrets)
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Platform Network Ports
# ------------------------------------------------------------------------------
GATEWAY_PORT=8080
CONTROL_PLANE_PORT=8082
THREAT_DETECTION_PORT=8000
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# Service Discovery / Service-to-Service URLs
# ------------------------------------------------------------------------------

# Gateway resolution and telemetry client for Control Plane
# Local standalone: http://localhost:8082
# Docker compose:   http://control-plane:8082
CONTROL_PLANE_URL=http://localhost:8082

# Gateway target for AI threat detection service (Phase 3)
# Local standalone: http://localhost:8000
# Docker compose:   http://threat-detection:8000
THREAT_DETECTION_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Gateway Configuration
# ------------------------------------------------------------------------------
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT_MS=5000
GATEWAY_CONFIG_CACHE_TTL_MS=5000
GATEWAY_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# Security & Policy Settings
# ------------------------------------------------------------------------------
# Set to 'true' in development to permit localhost / private addresses for testing
# Set to 'false' in production to enforce strict SSRF blocking
ALLOW_LOCAL_DEVELOPMENT=true

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL 16)
# ------------------------------------------------------------------------------
# Local dev defaults to in-memory H2 with PostgreSQL compatibility mode.
# When running with Docker Compose, set these to target PostgreSQL:
POSTGRES_HOST=postgres
POSTGRES_PORT=5435
POSTGRES_DB=api_security_platform
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=platform_dev_password_placeholder

# ------------------------------------------------------------------------------
# Cache & Rate Limiting Configuration (Redis - Phase 4)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_password_placeholder

# ------------------------------------------------------------------------------
# AI Threat Detection Service Configuration (Python / FastAPI - Phase 3)
# ------------------------------------------------------------------------------
THREAT_MODEL_PATH=models/isolation_forest.joblib
THREAT_DETECTION_LOG_LEVEL=info
RISK_THRESHOLD_MEDIUM=0.50
RISK_THRESHOLD_HIGH=0.80
